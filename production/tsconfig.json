{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "office-js", "vite/client", "node"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
